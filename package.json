{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm --filter ./artifacts/hisab-kitab --filter ./artifacts/api-server run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "pre-deploy-check": "./scripts/pre-deploy-check.sh",
    "deploy": "./scripts/deploy.sh",
    "rollback": "./scripts/rollback.sh",
    "post-deploy-verify": "./scripts/post-deploy-verify.sh",
    "backup:database": "./scripts/backup-database.sh",
    "backup:config": "./scripts/backup-config.sh",
    "recover:database": "./scripts/recover-database.sh",
    "verify:backup": "./scripts/verify-backup.sh"
  },
  "private": true,
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "prettier": "^3.8.4",
    "typescript": "~5.9.3",
    "vitest": "^2.1.9"
  }
}
